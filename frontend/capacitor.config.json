{
  "appId": "com.chatapp.mobile",
  "appName": "ChatApp",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    },
    "PushNotifications": {
      "presentationOptions": ["alert", "banner", "list", "sound"]
    }
  }
}
