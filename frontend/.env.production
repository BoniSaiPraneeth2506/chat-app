# Public origin used to build shareable links (QR code / "Copy Chat Link").
# Set this to wherever the web app is hosted. It matters most for the Android
# build: inside the Capacitor WebView `window.location.origin` is
# `https://localhost`, which would produce a QR nobody else can open.
# Left unset, links fall back to the VITE_API_URL origin above.
# VITE_PUBLIC_APP_URL=https://your-frontend-domain.com
